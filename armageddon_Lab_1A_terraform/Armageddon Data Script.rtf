    s = json.loads(resp["SecretString"])\
    # When you use "Credentials for RDS database", AWS usually stores:\
    # username, password, host, port, dbname (sometimes)\
    return s\
\
def get_conn():\
    c = get_db_creds()\
    host = c["host"]\
    user = c["username"]\
    password = c["password"]\
    port = int(c.get("port", 3306))\
