#!/bin/bash
#------------------------------------------------------------------------------
# EC2 Bootstrap - Offline Repository Mode with Channel Pointers
#------------------------------------------------------------------------------
# Lab 1c Airgap Mode: Installs all dependencies from a signed, verified
# offline release in S3. No internet access required.
#
# Security model (3-key architecture):
#   - Three role-specific GPG keys embedded at deploy time (not from S3)
#   - All key fingerprints pinned and verified before import
#   - Manifest GPG signature verified before trusting any artifact
#   - Every artifact SHA256-verified against signed manifest
#   - Strict mode: unexpected extra files cause failure
#   - DNF gpgcheck + repo_gpgcheck enforced
#   - No install fallbacks: fail closed on any verification error
#------------------------------------------------------------------------------
set -euo pipefail

#------------------------------------------------------------------------------
# Configuration (injected by Terraform)
#------------------------------------------------------------------------------
AWS_REGION="${aws_region}"
SECRET_NAME="${secret_name}"
LOG_GROUP="${log_group}"
BUCKET="${deps_bucket_name}"
CHANNEL="${channel}"
ENABLE_DNF_UPDATE="${enable_dnf_update}"

# 3-key fingerprints (pinned at deploy time)
RELEASE_EXPECTED_FPR="${release_gpg_key_fingerprint}"
REPO_EXPECTED_FPR="${repo_gpg_key_fingerprint}"
RPM_EXPECTED_FPR="${rpm_gpg_key_fingerprint}"

#------------------------------------------------------------------------------
# Logging Setup
#------------------------------------------------------------------------------
LOG=/var/log/notes-app.log
mkdir -p "$(dirname "$LOG")"
exec > >(tee -a "$LOG") 2>&1
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"; }
die() { log "FATAL: $1"; exit 1; }

log "========================================"
log "OFFLINE REPO MODE - Channel: $CHANNEL"
log "========================================"
log "Bucket: $BUCKET"
log "Region: $AWS_REGION"

#------------------------------------------------------------------------------
# Helper Functions
#------------------------------------------------------------------------------

# Strip leading/trailing whitespace, CR, LF
strip_ws() {
    local v="$1"
    v="$${v%"$${v##*[![:space:]]}"}"  # trailing whitespace
    v="$${v#"$${v%%[![:space:]]*}"}"  # leading whitespace
    printf '%s' "$v"
}

# Verify a GPG key file's fingerprint BEFORE importing into any keyring.
verify_key_fingerprint() {
    local key_file="$1"
    local expected_fpr="$2"
    local label="$3"
    local actual_fpr
    actual_fpr=$(gpg --batch --with-colons --show-keys "$key_file" 2>/dev/null \
        | awk -F: '/^fpr:/{print $10; exit}')
    if [[ -z "$actual_fpr" ]]; then
        die "Cannot extract fingerprint from embedded key: $label"
    fi
    if [[ "$actual_fpr" != "$expected_fpr" ]]; then
        die "Key fingerprint mismatch for $label! Expected: $expected_fpr, Got: $actual_fpr"
    fi
    log "Key fingerprint verified ($label): $actual_fpr"
}

#------------------------------------------------------------------------------
# Create working directories
#------------------------------------------------------------------------------
WORK_DIR="/opt/offline"
mkdir -p "$WORK_DIR/rpmrepo" "$WORK_DIR/pip/wheels" "$WORK_DIR/keys" \
         /etc/pki/rpm-gpg

#------------------------------------------------------------------------------
# Step 1: Read Channel Pointers
#------------------------------------------------------------------------------
log "Reading channel pointers for '$CHANNEL'..."

RPM_PREFIX_RAW=$(aws s3 cp "s3://$BUCKET/repo/rpm/channels/$CHANNEL" - --region "$AWS_REGION" 2>/dev/null) \
    || die "Failed to read RPM channel pointer"
PIP_PREFIX_RAW=$(aws s3 cp "s3://$BUCKET/repo/pip/channels/$CHANNEL" - --region "$AWS_REGION" 2>/dev/null) \
    || die "Failed to read pip channel pointer"
CW_PREFIX_RAW=$(aws s3 cp "s3://$BUCKET/repo/cw-agent/channels/$CHANNEL" - --region "$AWS_REGION" 2>/dev/null) \
    || die "Failed to read CW agent channel pointer"

RPM_PREFIX=$(strip_ws "$RPM_PREFIX_RAW")
PIP_PREFIX=$(strip_ws "$PIP_PREFIX_RAW")
CW_PREFIX=$(strip_ws "$CW_PREFIX_RAW")

[[ "$RPM_PREFIX" == repo/rpm/releases/* ]] \
    || die "Invalid RPM channel pointer: expected 'repo/rpm/releases/...', got '$RPM_PREFIX'"
[[ "$PIP_PREFIX" == repo/pip/releases/* ]] \
    || die "Invalid pip channel pointer: expected 'repo/pip/releases/...', got '$PIP_PREFIX'"
[[ "$CW_PREFIX" == repo/cw-agent/releases/* ]] \
    || die "Invalid CW agent channel pointer: expected 'repo/cw-agent/releases/...', got '$CW_PREFIX'"

log "RPM prefix: $RPM_PREFIX"
log "Pip prefix: $PIP_PREFIX"
log "CW prefix:  $CW_PREFIX"

RELEASE_ID=$(echo "$RPM_PREFIX" | grep -oP 'releases/\K[^/]+' || echo "unknown")
log "Release ID: $RELEASE_ID"

#------------------------------------------------------------------------------
# Step 2: Download Manifest, Embed Keys, Verify Signatures
#------------------------------------------------------------------------------
log "Downloading manifest and signature..."

MANIFEST_FILE="$WORK_DIR/$RELEASE_ID.json"
SIG_FILE="$WORK_DIR/$RELEASE_ID.json.sig"
SHA_FILE="$WORK_DIR/$RELEASE_ID.json.sha256"

RELEASE_KEY_FILE="$WORK_DIR/keys/release-signing-public.gpg"
RPM_KEY_FILE="$WORK_DIR/keys/rpm-packages-signing-public.gpg"
REPO_KEY_FILE="$WORK_DIR/keys/repo-metadata-signing-public.gpg"

aws s3 cp "s3://$BUCKET/manifests/$RELEASE_ID.json" "$MANIFEST_FILE" --region "$AWS_REGION" \
    || die "Failed to download manifest"
aws s3 cp "s3://$BUCKET/manifests/$RELEASE_ID.json.sig" "$SIG_FILE" --region "$AWS_REGION" \
    || die "Failed to download manifest signature"
aws s3 cp "s3://$BUCKET/manifests/$RELEASE_ID.json.sha256" "$SHA_FILE" --region "$AWS_REGION" \
    || die "Failed to download manifest checksum"

# Embed the 3 signing public keys (injected by Terraform at deploy time)
cat > "$RELEASE_KEY_FILE" << 'EMBEDDED_RELEASE_KEY'
${release_public_key}
EMBEDDED_RELEASE_KEY

cat > "$RPM_KEY_FILE" << 'EMBEDDED_RPM_KEY'
${rpm_packages_public_key}
EMBEDDED_RPM_KEY

cat > "$REPO_KEY_FILE" << 'EMBEDDED_REPO_KEY'
${repo_metadata_public_key}
EMBEDDED_REPO_KEY

# Verify ALL key fingerprints BEFORE importing
verify_key_fingerprint "$RELEASE_KEY_FILE" "$RELEASE_EXPECTED_FPR" "release-signing"
verify_key_fingerprint "$RPM_KEY_FILE" "$RPM_EXPECTED_FPR" "rpm-packages-signing"
verify_key_fingerprint "$REPO_KEY_FILE" "$REPO_EXPECTED_FPR" "repo-metadata-signing"

# Verify manifest SHA256
log "Verifying manifest checksum..."
EXPECTED_SHA=$(cat "$SHA_FILE")
ACTUAL_SHA=$(sha256sum "$MANIFEST_FILE" | cut -d' ' -f1)
if [[ "$EXPECTED_SHA" != "$ACTUAL_SHA" ]]; then
    die "Manifest checksum mismatch! Expected: $EXPECTED_SHA, Got: $ACTUAL_SHA"
fi
log "Manifest checksum verified"

# Verify GPG signature using embedded RELEASE key
log "Verifying GPG signature with embedded release signing key..."

if grep -q "UNSIGNED" "$SIG_FILE" 2>/dev/null; then
    die "Manifest is UNSIGNED (placeholder signature) - refusing to install unverified artifacts"
fi

export GNUPGHOME="$WORK_DIR/.gnupg"
mkdir -p "$GNUPGHOME"
chmod 700 "$GNUPGHOME"

gpg --batch --import "$RELEASE_KEY_FILE" 2>&1 | head -5 || true

if ! gpg --batch --list-keys 2>/dev/null | grep -q "pub"; then
    die "Failed to import release signing key"
fi
log "Release signing key imported into verification keyring"

if gpg --batch --verify "$SIG_FILE" "$MANIFEST_FILE" 2>&1 | grep -q "Good signature"; then
    log "GPG signature verified successfully"
else
    die "GPG signature verification FAILED - manifest may be tampered with"
fi

# Cross-check: manifest signing fingerprints must match embedded keys
log "Cross-checking manifest signing fingerprints against embedded keys..."

FPR_OUTPUT=$(python3 - "$MANIFEST_FILE" << 'FPR_PYEOF'
import json, sys
try:
    with open(sys.argv[1]) as f:
        m = json.load(f)
except json.JSONDecodeError as e:
    print("manifest is not valid JSON: {}".format(e), file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print("cannot read manifest: {}".format(e), file=sys.stderr)
    sys.exit(1)

signing = m.get("signing")
if not isinstance(signing, dict):
    print("manifest missing 'signing' block", file=sys.stderr)
    sys.exit(1)

required = ["release_manifest_fpr", "repo_metadata_fpr", "rpm_packages_fpr"]
for key in required:
    val = signing.get(key)
    if not val or not isinstance(val, str) or len(val) != 40:
        print("signing.{} missing or invalid (expected 40 hex chars, got: {!r})".format(key, val), file=sys.stderr)
        sys.exit(1)
    print("{}={}".format(key, val))
FPR_PYEOF
) || die "Failed to extract signing fingerprints from manifest"

MANIFEST_RELEASE_FPR=$(echo "$FPR_OUTPUT" | awk -F= '/^release_manifest_fpr=/{print $2}')
MANIFEST_REPO_FPR=$(echo "$FPR_OUTPUT" | awk -F= '/^repo_metadata_fpr=/{print $2}')
MANIFEST_RPM_FPR=$(echo "$FPR_OUTPUT" | awk -F= '/^rpm_packages_fpr=/{print $2}')

[[ "$MANIFEST_RELEASE_FPR" == "$RELEASE_EXPECTED_FPR" ]] \
    || die "Manifest release_manifest_fpr mismatch: deploy=$RELEASE_EXPECTED_FPR, manifest=$MANIFEST_RELEASE_FPR"
[[ "$MANIFEST_REPO_FPR" == "$REPO_EXPECTED_FPR" ]] \
    || die "Manifest repo_metadata_fpr mismatch: deploy=$REPO_EXPECTED_FPR, manifest=$MANIFEST_REPO_FPR"
[[ "$MANIFEST_RPM_FPR" == "$RPM_EXPECTED_FPR" ]] \
    || die "Manifest rpm_packages_fpr mismatch: deploy=$RPM_EXPECTED_FPR, manifest=$MANIFEST_RPM_FPR"
log "Manifest signing fingerprints match embedded keys"

#------------------------------------------------------------------------------
# Step 3: Sync Release Artifacts
#------------------------------------------------------------------------------
log "Syncing RPM repository..."
aws s3 sync "s3://$BUCKET/$RPM_PREFIX" "$WORK_DIR/rpmrepo/" --region "$AWS_REGION" --quiet \
    || die "Failed to sync RPM repo"

log "Syncing pip wheels..."
aws s3 sync "s3://$BUCKET/$PIP_PREFIX" "$WORK_DIR/pip/" --region "$AWS_REGION" --quiet \
    || die "Failed to sync pip wheelhouse"

log "Downloading CloudWatch agent..."
CW_PREFIX_NORM="$${CW_PREFIX%/}"
aws s3 cp "s3://$BUCKET/$CW_PREFIX_NORM/amazon-cloudwatch-agent.rpm" "$WORK_DIR/amazon-cloudwatch-agent.rpm" \
    --region "$AWS_REGION" --quiet \
    || die "Failed to download CW agent"

#------------------------------------------------------------------------------
# Step 4: Verify ALL Artifacts Against Signed Manifest (Strict Mode)
#------------------------------------------------------------------------------
log "Verifying all artifacts against signed manifest (strict mode)..."

python3 - "$MANIFEST_FILE" "$WORK_DIR" "$RPM_PREFIX" "$PIP_PREFIX" "$CW_PREFIX" << 'VERIFY_PYEOF'
import json, hashlib, os, sys

manifest_path = sys.argv[1]
work_dir = sys.argv[2]
rpm_prefix = sys.argv[3]
pip_prefix = sys.argv[4]
cw_prefix = sys.argv[5]

with open(manifest_path) as f:
    manifest = json.load(f)

errors = []
expected_files = set()
work_dir_real = os.path.realpath(work_dir)

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(8192), b""):
            h.update(chunk)
    return h.hexdigest()

def resolve_local_path(manifest_rel_path):
    if manifest_rel_path.startswith(rpm_prefix):
        rel = manifest_rel_path[len(rpm_prefix):]
        return os.path.join(work_dir, "rpmrepo", rel)
    elif manifest_rel_path.startswith(pip_prefix):
        rel = manifest_rel_path[len(pip_prefix):]
        return os.path.join(work_dir, "pip", rel)
    elif manifest_rel_path.startswith(cw_prefix.rstrip("/") + "/"):
        rel = manifest_rel_path[len(cw_prefix.rstrip("/") + "/"):]
        return os.path.join(work_dir, rel)
    else:
        return None

def verify_artifact(entry, label=""):
    path = entry["path"]
    expected_hash = entry["sha256"]
    local = resolve_local_path(path)
    if local is None:
        errors.append("Cannot resolve local path for: {} ({})".format(path, label))
        return
    real = os.path.realpath(local)
    if not real.startswith(work_dir_real + os.sep) and real != work_dir_real:
        errors.append("PATH TRAVERSAL BLOCKED: {} resolves to {} (outside {})".format(path, real, work_dir_real))
        return
    expected_files.add(real)
    if not os.path.exists(local):
        errors.append("MISSING FILE: {} (expected at {})".format(path, local))
        return
    actual_hash = sha256_file(local)
    if actual_hash != expected_hash:
        errors.append("HASH MISMATCH: {} expected={} actual={}".format(path, expected_hash, actual_hash))

for pkg in manifest.get("rpm", {}).get("packages", []):
    verify_artifact(pkg, "rpm")
for rd in manifest.get("rpm", {}).get("repodata", []):
    verify_artifact(rd, "repodata")
for whl in manifest.get("pip", {}).get("wheels", []):
    verify_artifact(whl, "wheel")
rl = manifest.get("pip", {}).get("requirements_lock")
if rl:
    verify_artifact(rl, "requirements.lock")
else:
    errors.append("Manifest missing pip.requirements_lock entry")
rlc = manifest.get("pip", {}).get("requirements_lock_checksum")
if rlc:
    verify_artifact(rlc, "requirements.lock.sha256")
ri = manifest.get("pip", {}).get("requirements_in")
if ri:
    verify_artifact(ri, "requirements.in")
cw = manifest.get("cw_agent", {}).get("rpm")
if cw:
    verify_artifact(cw, "cw-agent")
else:
    errors.append("Manifest missing cw_agent.rpm entry")

# Strict mode: reject extra files
repodata_real = os.path.realpath(os.path.join(work_dir, "rpmrepo", "repodata"))

def is_repodata_index(fpath):
    if not fpath.startswith(repodata_real + os.sep):
        return False
    basename = os.path.basename(fpath)
    if basename in ("repomd.xml", "repomd.xml.asc"):
        return False
    return True

def walk_for_extras(directory):
    if not os.path.isdir(directory):
        return
    for root, dirs, files in os.walk(directory):
        for fname in files:
            fpath = os.path.realpath(os.path.join(root, fname))
            if fpath not in expected_files and not is_repodata_index(fpath):
                errors.append("UNEXPECTED EXTRA FILE: {}".format(fpath))

walk_for_extras(os.path.join(work_dir, "rpmrepo"))
walk_for_extras(os.path.join(work_dir, "pip"))

cw_path = os.path.realpath(os.path.join(work_dir, "amazon-cloudwatch-agent.rpm"))
if os.path.exists(cw_path) and cw_path not in expected_files:
    errors.append("UNEXPECTED EXTRA FILE: {}".format(cw_path))

if errors:
    print("ARTIFACT VERIFICATION FAILED ({} errors):".format(len(errors)), file=sys.stderr)
    for e in errors:
        print("  - {}".format(e), file=sys.stderr)
    sys.exit(1)
else:
    print("All {} artifacts verified successfully".format(len(expected_files)))
    sys.exit(0)
VERIFY_PYEOF

log "Artifact verification passed"

#------------------------------------------------------------------------------
# Step 5: Configure Offline DNF Repository
#------------------------------------------------------------------------------
log "Configuring offline DNF repository..."

cp "$RPM_KEY_FILE" /etc/pki/rpm-gpg/RPM-GPG-KEY-offline-rpm
rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-offline-rpm \
    || die "Failed to import RPM packages signing key"
log "RPM packages signing key imported"

cp "$REPO_KEY_FILE" /etc/pki/rpm-gpg/RPM-GPG-KEY-offline-repo
rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-offline-repo \
    || die "Failed to import repo metadata signing key"
log "Repo metadata signing key imported"

mkdir -p /etc/yum.repos.d.bak
mv /etc/yum.repos.d/*.repo /etc/yum.repos.d.bak/ 2>/dev/null || true

cat > /etc/yum.repos.d/offline.repo << 'REPO'
[offline]
name=Offline Repository
baseurl=file:///opt/offline/rpmrepo
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-offline-rpm
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-offline-repo
REPO

log "Offline repo configured (gpgcheck=1, repo_gpgcheck=1)"

# DNF makecache preflight
log "Running DNF makecache preflight..."
test -s "$WORK_DIR/rpmrepo/repodata/repomd.xml.asc" \
    || die "repomd.xml.asc missing or empty"
log "repomd.xml.asc present ($(wc -c < "$WORK_DIR/rpmrepo/repodata/repomd.xml.asc") bytes)"

dnf clean all 2>/dev/null || true
if ! dnf makecache --disablerepo='*' --enablerepo=offline -v 2>&1; then
    log "--- DNF makecache failed. Diagnostics: ---"
    cat /etc/yum.repos.d/offline.repo >&2 || true
    ls -la "$WORK_DIR/rpmrepo/repodata/" 2>&1 || true
    rpm -qa gpg-pubkey* 2>&1 || true
    die "DNF makecache failed - repo metadata or signature verification issue"
fi
log "DNF makecache passed"

#------------------------------------------------------------------------------
# Step 6: Install System Packages (fail closed)
#------------------------------------------------------------------------------
log "Installing system packages from offline repo..."

# Optional dnf update from offline repo
if [[ "$ENABLE_DNF_UPDATE" == "true" ]]; then
    log "Running dnf update from offline repo..."
    dnf update -y --disablerepo='*' --enablerepo=offline 2>&1 || log "dnf update had issues (non-fatal)"
fi

if ! dnf install -y --disablerepo='*' --enablerepo=offline python3-pip 2>&1; then
    log "--- DNF install failed. Diagnostics: ---"
    ls -la "$WORK_DIR/rpmrepo/"*.rpm 2>&1 | head -20 || true
    rpm -qa | grep python3 2>&1 || true
    die "DNF install failed - refusing to continue with partial install"
fi

python3 -m pip --version || die "pip installation failed"
log "System packages installed"

#------------------------------------------------------------------------------
# Step 7: Install Python Packages with Hash Verification
#------------------------------------------------------------------------------
log "Installing Python packages with hash verification..."

LOCK_FILE="$WORK_DIR/pip/requirements.lock"
if [[ ! -f "$LOCK_FILE" ]]; then
    die "requirements.lock not found at $LOCK_FILE"
fi

LOCK_SHA_FILE="$WORK_DIR/pip/requirements.lock.sha256"
if [[ -f "$LOCK_SHA_FILE" ]]; then
    EXPECTED_LOCK_SHA=$(cat "$LOCK_SHA_FILE")
    ACTUAL_LOCK_SHA=$(sha256sum "$LOCK_FILE" | cut -d' ' -f1)
    if [[ "$EXPECTED_LOCK_SHA" != "$ACTUAL_LOCK_SHA" ]]; then
        die "requirements.lock checksum mismatch"
    fi
    log "requirements.lock cross-check passed"
fi

pip3 install \
    --no-index \
    --find-links="$WORK_DIR/pip/wheels" \
    --require-hashes \
    -r "$LOCK_FILE" 2>&1 \
    || die "pip install with --require-hashes failed"

python3 -c "import flask; print(f'Flask {flask.__version__} installed')" || die "Flask not installed"
log "Python packages installed with hash verification"

#------------------------------------------------------------------------------
# Step 8: Install CloudWatch Agent
#------------------------------------------------------------------------------
log "Installing CloudWatch agent..."
rpm -U "$WORK_DIR/amazon-cloudwatch-agent.rpm" 2>/dev/null || log "CW agent already installed"

cat > /opt/aws/amazon-cloudwatch-agent/etc/cloudwatch-config.json << EOF
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "$LOG",
            "log_group_name": "$LOG_GROUP",
            "log_stream_name": "{instance_id}/app.log",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
EOF

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
    -a fetch-config -m ec2 -s \
    -c file:/opt/aws/amazon-cloudwatch-agent/etc/cloudwatch-config.json

if systemctl is-active --quiet amazon-cloudwatch-agent; then
    log "CloudWatch agent started successfully"
else
    log "WARNING: CloudWatch agent failed to start"
fi

#------------------------------------------------------------------------------
# Step 9: Create Flask Application
#------------------------------------------------------------------------------
log "Creating Flask application..."
APP_DIR="/opt/notes-app"
mkdir -p "$APP_DIR"

cat > "$APP_DIR/app.py" << 'FLASK_APP'
#!/usr/bin/env python3
"""
Notes App - Flask application for EC2->RDS lab (Lab 1c - Private Compute)
Endpoints:
  GET /init      - Create notes table
  GET /add?note= - Add a note
  GET /list      - List all notes
  GET /health    - Health check
"""

import json
import logging
import subprocess
import sys
import os
from flask import Flask, request, jsonify

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('/var/log/notes-app.log'),
        logging.StreamHandler(sys.stdout)
    ]
)
logger = logging.getLogger(__name__)

app = Flask(__name__)

DB_CONFIG = None


def get_db_credentials():
    """Fetch database credentials from AWS Secrets Manager via VPC endpoint."""
    global DB_CONFIG
    if DB_CONFIG is not None:
        return DB_CONFIG

    region = os.environ.get('AWS_REGION', 'us-east-1')
    secret_name = os.environ.get('SECRET_NAME', 'lab/rds/mysql')

    logger.info(f"Fetching secret '{secret_name}' from region '{region}'...")

    try:
        result = subprocess.run(
            [
                'aws', 'secretsmanager', 'get-secret-value',
                '--secret-id', secret_name,
                '--region', region,
                '--query', 'SecretString',
                '--output', 'text'
            ],
            capture_output=True,
            text=True,
            check=True
        )
        DB_CONFIG = json.loads(result.stdout.strip())
        logger.info(f"Successfully retrieved credentials for host: {DB_CONFIG.get('host', 'unknown')}")
        return DB_CONFIG
    except subprocess.CalledProcessError as e:
        logger.error(f"Failed to get secret: {e.stderr}")
        raise
    except json.JSONDecodeError as e:
        logger.error(f"Failed to parse secret JSON: {e}")
        raise


def get_db_connection():
    """Create a new database connection."""
    import pymysql
    try:
        creds = get_db_credentials()
        logger.info(f"Attempting DB connection to {creds['host']}:{creds['port']}")
        conn = pymysql.connect(
            host=creds['host'],
            port=int(creds['port']),
            user=creds['username'],
            password=creds['password'],
            database=creds['dbname'],
            charset='utf8mb4',
            cursorclass=pymysql.cursors.DictCursor,
            connect_timeout=5
        )
        logger.info("DB connection established successfully")
        return conn
    except Exception as e:
        logger.error(f"DB_CONNECTION_FAILURE {type(e).__name__}: {str(e)}")
        raise


@app.route('/health')
def health():
    """Health check endpoint."""
    return jsonify({
        'status': 'healthy',
        'mode': 'offline-repo',
        'channel': os.environ.get('CHANNEL', 'unknown')
    }), 200


@app.route('/init')
def init_db():
    """Initialize the notes table."""
    try:
        conn = get_db_connection()
        with conn.cursor() as cursor:
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS notes (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    content TEXT NOT NULL,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
            """)
        conn.commit()
        conn.close()
        logger.info("Database table 'notes' initialized successfully")
        return jsonify({
            'status': 'success',
            'message': 'Notes table created/verified successfully'
        }), 200
    except Exception as e:
        logger.error(f"Failed to initialize database: {e}")
        return jsonify({
            'status': 'error',
            'message': str(e)
        }), 500


@app.route('/add')
def add_note():
    """Add a new note. Usage: /add?note=your_note_here"""
    note = request.args.get('note', '').strip()
    if not note:
        return jsonify({
            'status': 'error',
            'message': 'Missing "note" query parameter. Usage: /add?note=your_note'
        }), 400

    try:
        conn = get_db_connection()
        with conn.cursor() as cursor:
            cursor.execute("INSERT INTO notes (content) VALUES (%s)", (note,))
        conn.commit()
        note_id = cursor.lastrowid
        conn.close()
        logger.info(f"Added note ID {note_id}: {note[:50]}...")
        return jsonify({
            'status': 'success',
            'message': f'Note added with ID {note_id}',
            'note_id': note_id
        }), 201
    except Exception as e:
        logger.error(f"Failed to add note: {e}")
        return jsonify({
            'status': 'error',
            'message': str(e)
        }), 500


@app.route('/list')
def list_notes():
    """List all notes."""
    try:
        conn = get_db_connection()
        with conn.cursor() as cursor:
            cursor.execute("SELECT id, content, created_at FROM notes ORDER BY created_at DESC")
            notes = cursor.fetchall()
        conn.close()

        for note in notes:
            note['created_at'] = str(note['created_at'])

        logger.info(f"Listed {len(notes)} notes")
        return jsonify({
            'status': 'success',
            'count': len(notes),
            'notes': notes
        }), 200
    except Exception as e:
        logger.error(f"Failed to list notes: {e}")
        return jsonify({
            'status': 'error',
            'message': str(e)
        }), 500


@app.route('/')
def index():
    """Root endpoint with usage instructions."""
    return jsonify({
        'app': 'Notes App (Lab 1c - Private Compute)',
        'mode': 'offline-repo',
        'channel': os.environ.get('CHANNEL', 'unknown'),
        'endpoints': {
            '/init': 'Initialize the notes table',
            '/add?note=TEXT': 'Add a new note',
            '/list': 'List all notes',
            '/health': 'Health check'
        }
    }), 200


if __name__ == '__main__':
    logger.info("Starting Flask application on port 80...")
    app.run(host='0.0.0.0', port=80, debug=False)
FLASK_APP

chmod +x "$APP_DIR/app.py"
log "Flask application created"

#------------------------------------------------------------------------------
# Step 10: Create and Start Systemd Service
#------------------------------------------------------------------------------
log "Creating systemd service..."

cat > /etc/systemd/system/notes-app.service << EOF
[Unit]
Description=Notes Flask Application (Lab 1c - Private Compute)
After=network.target amazon-cloudwatch-agent.service

[Service]
Type=simple
User=root
WorkingDirectory=$APP_DIR
Environment="AWS_REGION=$AWS_REGION"
Environment="SECRET_NAME=$SECRET_NAME"
Environment="CHANNEL=$CHANNEL"
ExecStart=/usr/bin/python3 $APP_DIR/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable notes-app
systemctl start notes-app

sleep 10

if systemctl is-active --quiet notes-app; then
    log "Notes App service started successfully!"
    sleep 2
    if ss -lntp | grep -q ':80'; then
        log "Port 80 is listening!"
    else
        log "WARNING: Port 80 not listening yet"
        ss -lntp || true
    fi
else
    log "ERROR: Notes App service failed to start!"
    systemctl status notes-app --no-pager || true
    journalctl -u notes-app -n 50 --no-pager || true
fi

#------------------------------------------------------------------------------
# Bootstrap Complete
#------------------------------------------------------------------------------
INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
log "========================================"
log "Bootstrap complete!"
log "========================================"
log "Release:  $RELEASE_ID"
log "Channel:  $CHANNEL"
log "Instance: $INSTANCE_ID"
log "CloudWatch Log Group: $LOG_GROUP"
log ""
log "SSM Connect: aws ssm start-session --target $INSTANCE_ID --region $AWS_REGION"
log "Port Forward: aws ssm start-session --target $INSTANCE_ID --document-name AWS-StartPortForwardingSession --parameters '{\"portNumber\":[\"80\"],\"localPortNumber\":[\"8080\"]}'"
