# versions.tf - Terraform and provider version constraints
#
# Lab 1c: Removed TLS provider (no SSH keys)

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.5"
    }
  }
}
